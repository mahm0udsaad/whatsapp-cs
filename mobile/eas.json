{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": {
        "EXPO_PUBLIC_APP_BASE_URL": "http://localhost:3000",
        "EXPO_PUBLIC_HR_API_URL": "https://nehgzhub-hr.com/api/v1"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": { "simulator": false },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_BASE_URL": "https://www.nehgzbot.com",
        "EXPO_PUBLIC_HR_API_URL": "https://nehgzhub-hr.com/api/v1",
        "EXPO_PUBLIC_HR_DEMO_CONTROLS": "1"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_APP_BASE_URL": "https://www.nehgzbot.com",
        "EXPO_PUBLIC_HR_API_URL": "https://nehgzhub-hr.com/api/v1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "daleelhksa@gmail.com",
        "ascAppId": "6762078573"
      }
    }
  }
}
